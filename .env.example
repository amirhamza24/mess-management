# Copy to .env.local and fill in.

# PostgreSQL connection string.
#   Local:    postgresql://postgres:password@localhost:5432/messhisab
#   Supabase: Project → Connect → Session pooler (port 5432)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Secret for signing session cookies (required in production).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=change-me

# Optional: starter accounts created by `npm run db:seed`
# SEED_MANAGER_EMAIL=manager@messhisab.com
# SEED_MANAGER_PASSWORD=Manager@123
# SEED_MEMBER_EMAIL=member@messhisab.com
# SEED_MEMBER_PASSWORD=Member@123
# SEED_MESS_NAME=Green House Bachelor Mess
