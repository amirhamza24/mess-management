// MessHisab database schema (PostgreSQL via Prisma).
//
// Accounting rules (implemented in src/lib/accounting.ts):
//   meal rate  = food expenses ÷ total meals        (food ONLY)
//   meal cost  = member meals × meal rate
//   total cost = meal cost + house rent + other expense share
//   balance    = total cost − paid                  (positive = due, negative = advance)
// House rent and other expenses never affect the meal rate.
//
// Field names are snake_case on purpose: query results are sent to the client
// as-is (after Decimal/Date serialisation) and match src/lib/types.ts.
//
// Multi-tenant: every mess is isolated. Monthly data hangs off a MonthlyCycle
// which belongs to exactly one Mess; members belong to exactly one Mess.
// All scoping/authorisation happens server-side (src/server/context.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Platform-level role. Super admins manage messes; they never belong to a mess.
enum PlatformRole {
  super_admin
  user
}

/// Role inside a mess (on Member).
enum Role {
  manager
  member
}

/// Account status. `pending` = waiting for the requested mess's manager to approve the join request.
enum UserStatus {
  pending
  approved
  rejected
  suspended
}

/// pending → (super admin) → active | rejected; active ⇄ inactive.
enum MessStatus {
  pending
  active
  inactive
  rejected
}

enum MemberStatus {
  active
  inactive
}

enum CycleStatus {
  open
  closed
}

enum MonthlyMemberStatus {
  active
  removed
}

enum PaymentMethod {
  cash
  bkash
  nagad
  bank
  other
}

/// `rent` payments count towards house-rent status; every payment counts towards settlement.
enum PaymentPurpose {
  mess
  rent
}

enum FoodCategory {
  rice
  fish
  meat
  chicken
  egg
  vegetable
  dal
  oil
  salt
  spice
  onion
  potato
  grocery
  other_food
}

enum OtherCategory {
  electricity
  gas
  water
  internet
  cleaning
  repair
  maid
  maintenance
  miscellaneous
}

/// App account.
model User {
  id                String       @id @default(uuid())
  name              String
  email             String       @unique
  phone             String?
  password          String
  platform_role     PlatformRole @default(user)
  status            UserStatus   @default(pending)
  /// Mess a pending user asked to join (approved by that mess's manager).
  requested_mess_id String?
  approved_at       DateTime?
  approved_by       String?
  created_at        DateTime     @default(now())
  updated_at        DateTime     @updatedAt

  member          Member?
  requested_mess  Mess?   @relation("JoinRequests", fields: [requested_mess_id], references: [id], onDelete: SetNull)
  created_messes  Mess[]  @relation("MessCreator")
  approved_messes Mess[]  @relation("MessApprover")
  rejected_messes Mess[]  @relation("MessRejecter")

  @@index([status])
  @@index([requested_mess_id])
  @@map("users")
}

model Mess {
  id               String     @id @default(uuid())
  name             String
  /// Lower-cased, whitespace-collapsed name: enforces case-insensitive uniqueness in the database.
  name_key         String     @unique
  slug             String     @unique
  address          String
  description      String?
  status           MessStatus @default(pending)
  created_by       String
  approved_by      String?
  approved_at      DateTime?
  rejected_by      String?
  rejected_at      DateTime?
  rejection_reason String?
  created_at       DateTime   @default(now())
  updated_at       DateTime   @updatedAt

  creator       User           @relation("MessCreator", fields: [created_by], references: [id], onDelete: Restrict)
  approver      User?          @relation("MessApprover", fields: [approved_by], references: [id], onDelete: SetNull)
  rejecter      User?          @relation("MessRejecter", fields: [rejected_by], references: [id], onDelete: SetNull)
  members       Member[]
  cycles        MonthlyCycle[]
  join_requests User[]         @relation("JoinRequests")
  activities    MessActivity[]

  @@index([status, created_at])
  @@map("messes")
}

/// Platform-level audit trail for a mess (shown to super admins).
model MessActivity {
  id         String   @id @default(uuid())
  mess_id    String
  actor_id   String?
  actor_name String
  action     String
  note       String?
  created_at DateTime @default(now())

  mess Mess @relation(fields: [mess_id], references: [id], onDelete: Cascade)

  @@index([mess_id, created_at])
  @@map("mess_activities")
}

/// Membership of a person in a mess (the "MessMember"). May exist without an
/// app account (user_id null). A user belongs to at most one mess.
model Member {
  id         String       @id @default(uuid())
  mess_id    String
  user_id    String?      @unique
  role       Role         @default(member)
  full_name  String
  email      String?
  phone      String?
  avatar_url String?
  status     MemberStatus @default(active)
  joined_at  DateTime     @default(now()) @db.Date
  left_at    DateTime?    @db.Date
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt

  mess            Mess            @relation(fields: [mess_id], references: [id], onDelete: Cascade)
  user            User?           @relation(fields: [user_id], references: [id], onDelete: SetNull)
  monthly_members MonthlyMember[]
  meals           Meal[]
  payments        Payment[]
  house_rents     HouseRent[]
  food_paid       FoodExpense[]
  other_paid      OtherExpense[]

  @@unique([mess_id, user_id])
  @@unique([mess_id, email])
  @@index([mess_id, role])
  @@map("members")
}

/// One accounting month. Closed months are read-only.
model MonthlyCycle {
  id         String      @id @default(uuid())
  mess_id    String
  year       Int
  month      Int
  status     CycleStatus @default(open)
  started_at DateTime    @default(now())
  closed_at  DateTime?

  mess            Mess            @relation(fields: [mess_id], references: [id], onDelete: Cascade)
  monthly_members MonthlyMember[]
  meals           Meal[]
  food_expenses   FoodExpense[]
  payments        Payment[]
  house_rents     HouseRent[]
  other_expenses  OtherExpense[]

  @@unique([mess_id, year, month])
  @@map("monthly_cycles")
}

model MonthlyMember {
  id               String              @id @default(uuid())
  monthly_cycle_id String
  member_id        String
  status           MonthlyMemberStatus @default(active)
  created_at       DateTime            @default(now())

  cycle  MonthlyCycle @relation(fields: [monthly_cycle_id], references: [id], onDelete: Cascade)
  member Member       @relation(fields: [member_id], references: [id], onDelete: Restrict)

  @@unique([monthly_cycle_id, member_id])
  @@index([member_id])
  @@map("monthly_members")
}

/// Meal values are 0 – 20 in steps of 0.5; a slot above 1 means extra/guest meals.
model Meal {
  id               String   @id @default(uuid())
  monthly_cycle_id String
  member_id        String
  date             DateTime @db.Date
  breakfast        Decimal  @default(0) @db.Decimal(4, 1)
  lunch            Decimal  @default(0) @db.Decimal(4, 1)
  dinner           Decimal  @default(0) @db.Decimal(4, 1)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  cycle  MonthlyCycle @relation(fields: [monthly_cycle_id], references: [id], onDelete: Cascade)
  member Member       @relation(fields: [member_id], references: [id], onDelete: Restrict)

  @@unique([monthly_cycle_id, member_id, date])
  @@index([member_id])
  @@index([monthly_cycle_id, date])
  @@map("meals")
}

model FoodExpense {
  id               String       @id @default(uuid())
  monthly_cycle_id String
  date             DateTime     @db.Date
  paid_by          String?
  category         FoodCategory
  description      String?
  amount           Decimal      @db.Decimal(12, 2)
  note             String?
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt

  cycle MonthlyCycle @relation(fields: [monthly_cycle_id], references: [id], onDelete: Cascade)
  payer Member?      @relation(fields: [paid_by], references: [id], onDelete: SetNull)

  @@index([monthly_cycle_id, date])
  @@map("food_expenses")
}

model Payment {
  id               String         @id @default(uuid())
  monthly_cycle_id String
  member_id        String
  date             DateTime       @db.Date
  amount           Decimal        @db.Decimal(12, 2)
  payment_method   PaymentMethod  @default(cash)
  purpose          PaymentPurpose @default(mess)
  note             String?
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt

  cycle  MonthlyCycle @relation(fields: [monthly_cycle_id], references: [id], onDelete: Cascade)
  member Member       @relation(fields: [member_id], references: [id], onDelete: Restrict)

  @@index([monthly_cycle_id, date])
  @@index([member_id])
  @@map("payments")
}

/// Rent owed by a member for a month. Paid status is derived from `rent` payments.
model HouseRent {
  id               String   @id @default(uuid())
  monthly_cycle_id String
  member_id        String
  amount           Decimal  @default(0) @db.Decimal(12, 2)
  note             String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  cycle  MonthlyCycle @relation(fields: [monthly_cycle_id], references: [id], onDelete: Cascade)
  member Member       @relation(fields: [member_id], references: [id], onDelete: Restrict)

  @@unique([monthly_cycle_id, member_id])
  @@index([member_id])
  @@map("house_rents")
}

model OtherExpense {
  id               String        @id @default(uuid())
  monthly_cycle_id String
  date             DateTime      @db.Date
  category         OtherCategory
  description      String?
  amount           Decimal       @db.Decimal(12, 2)
  paid_by          String?
  note             String?
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  cycle MonthlyCycle @relation(fields: [monthly_cycle_id], references: [id], onDelete: Cascade)
  payer Member?      @relation(fields: [paid_by], references: [id], onDelete: SetNull)

  @@index([monthly_cycle_id, date])
  @@map("other_expenses")
}
